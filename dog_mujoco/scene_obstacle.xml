<?xml version='1.0' encoding='utf-8'?>
<!-- Obstacle course for train/train_obstacle.py: the IMU-position gait robot (robot_gait_imu.xml,
     with foot contact sensors) on a floor with bars ("ledges") across the walking direction.
     Bars: 3 cm deep (x), 2 m wide (y, so they cannot be walked around), 8-12 mm high
     (about 1 cm, cycling 8/10/12/10 mm), one every 25 cm starting at x = 0.12 m.
     The robot starts between x = -0.20 and 0.00 (set in tasks/walk_obstacle.yaml), so the
     first bar is 7-27 cm ahead of its front feet. -->
<mujoco model="mg90s_dog_scene_obstacle">
  <include file="robot_gait_imu.xml" />
  <visual>
    <global offwidth="1400" offheight="1000" />
    <headlight ambient="0.45 0.45 0.45" diffuse="0.65 0.65 0.65" />
  </visual>
  <worldbody>
    <light pos="0.3 -0.3 0.8" dir="-0.3 0.3 -0.8" />
    <geom name="floor" type="plane" size="4 2 0.1" rgba="0.92 0.94 0.96 1" friction="0.8 0.005 0.0001" />
    <geom name="bar_00" type="box" size="0.015 1.0 0.0040" pos="0.120 0 0.0040" rgba="0.85 0.45 0.2 1" friction="0.8 0.005 0.0001" />
    <geom name="bar_01" type="box" size="0.015 1.0 0.0050" pos="0.370 0 0.0050" rgba="0.85 0.45 0.2 1" friction="0.8 0.005 0.0001" />
    <geom name="bar_02" type="box" size="0.015 1.0 0.0060" pos="0.620 0 0.0060" rgba="0.85 0.45 0.2 1" friction="0.8 0.005 0.0001" />
    <geom name="bar_03" type="box" size="0.015 1.0 0.0050" pos="0.870 0 0.0050" rgba="0.85 0.45 0.2 1" friction="0.8 0.005 0.0001" />
    <geom name="bar_04" type="box" size="0.015 1.0 0.0040" pos="1.120 0 0.0040" rgba="0.85 0.45 0.2 1" friction="0.8 0.005 0.0001" />
    <geom name="bar_05" type="box" size="0.015 1.0 0.0050" pos="1.370 0 0.0050" rgba="0.85 0.45 0.2 1" friction="0.8 0.005 0.0001" />
    <geom name="bar_06" type="box" size="0.015 1.0 0.0060" pos="1.620 0 0.0060" rgba="0.85 0.45 0.2 1" friction="0.8 0.005 0.0001" />
    <geom name="bar_07" type="box" size="0.015 1.0 0.0050" pos="1.870 0 0.0050" rgba="0.85 0.45 0.2 1" friction="0.8 0.005 0.0001" />
    <geom name="bar_08" type="box" size="0.015 1.0 0.0040" pos="2.120 0 0.0040" rgba="0.85 0.45 0.2 1" friction="0.8 0.005 0.0001" />
    <geom name="bar_09" type="box" size="0.015 1.0 0.0050" pos="2.370 0 0.0050" rgba="0.85 0.45 0.2 1" friction="0.8 0.005 0.0001" />
    <geom name="bar_10" type="box" size="0.015 1.0 0.0060" pos="2.620 0 0.0060" rgba="0.85 0.45 0.2 1" friction="0.8 0.005 0.0001" />
    <geom name="bar_11" type="box" size="0.015 1.0 0.0050" pos="2.870 0 0.0050" rgba="0.85 0.45 0.2 1" friction="0.8 0.005 0.0001" />
  </worldbody>
</mujoco>
